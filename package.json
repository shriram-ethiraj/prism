{
  "name": "prism",
  "version": "0.2.10",
  "private": true,
  "type": "module",
  "description": "Local-first fullscreen launcher for Samsung Tizen monitors",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "assets": "node scripts/prepare-assets.mjs",
    "check": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/state.test.ts tests/press.test.ts tests/context-menu.test.ts tests/catalog-cache.test.ts tests/wallpaper-load.test.ts tests/spatial.test.ts",
    "test:browser": "playwright test",
    "test:packages": "node --test tests/package.test.mjs tests/build-lock.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.0.0",
    "fflate": "^0.8.3",
    "prettier": "^3.9.10",
    "sharp": "0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shriram-ethiraj/prism.git"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
